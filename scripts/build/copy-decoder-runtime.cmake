cmake_minimum_required(VERSION 3.25)

if(NOT IS_DIRECTORY "${AEGINEXT_FFMPEG_ROOT}/bin" OR NOT AEGINEXT_NATIVE_OUTPUT_DIR)
    message(FATAL_ERROR "A selected FFmpeg development package and output directory are required.")
endif()

string(REPLACE "[" "[[]" escaped_root "${AEGINEXT_FFMPEG_ROOT}")
file(GLOB runtime_libraries LIST_DIRECTORIES false "${escaped_root}/bin/*.dll")
if(NOT runtime_libraries)
    message(FATAL_ERROR "The selected FFmpeg package has no runtime DLLs.")
endif()

file(MAKE_DIRECTORY "${AEGINEXT_NATIVE_OUTPUT_DIR}")
foreach(library IN LISTS runtime_libraries)
    get_filename_component(library_name "${library}" NAME)
    file(COPY_FILE "${library}" "${AEGINEXT_NATIVE_OUTPUT_DIR}/${library_name}" ONLY_IF_DIFFERENT)
endforeach()
if(AEGINEXT_SDL_ROOT)
    if(NOT EXISTS "${AEGINEXT_SDL_ROOT}/bin/SDL3.dll")
        message(FATAL_ERROR "Selected SDL3 development package has no SDL3.dll")
    endif()
    file(COPY_FILE "${AEGINEXT_SDL_ROOT}/bin/SDL3.dll" "${AEGINEXT_NATIVE_OUTPUT_DIR}/SDL3.dll" ONLY_IF_DIFFERENT)
endif()
message(STATUS "Staged selected FFmpeg runtime DLLs for development; this is not a release bundle.")
