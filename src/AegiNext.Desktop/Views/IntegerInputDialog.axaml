<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:AegiNext.Desktop.Views"
        xmlns:common="using:AegiNext.Desktop.Controls.Common"
        xmlns:inputs="using:AegiNext.Desktop.Controls"
        x:Class="AegiNext.Desktop.Views.IntegerInputDialog"
        x:DataType="views:IntegerInputDialogViewModel"
        Classes="business-surface" Title="{Binding Title}"
        Width="440" MinWidth="360" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource PreviewBackground}">
  <Grid RowDefinitions="Auto,Auto">
    <common:WindowTitleBar Name="IntegerInputTitleBar" />
    <Grid Grid.Row="1" Margin="24" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="16">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
        <TextBlock Name="IntegerInputLabel" Text="{Binding Label}" VerticalAlignment="Center" />
        <inputs:NumericDraftInput Name="IntegerInput" Grid.Column="1"
                                  RawText="{Binding RawText, Mode=TwoWay}"
                                  Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                                  Increment="1" FormatString="0" PreserveDoublePrecision="True"
                                  AutomationProperties.Name="{Binding Label}" />
      </Grid>
      <TextBlock Name="IntegerInputHint" Grid.Row="1" Text="{Binding Hint}" TextWrapping="Wrap"
                 Foreground="{DynamicResource PreviewMuted}" />
      <TextBlock Name="IntegerInputError" Grid.Row="2" Text="{Binding Error}" IsVisible="{Binding HasError}"
                 TextWrapping="Wrap" Foreground="{DynamicResource PreviewError}" />
      <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Name="CancelButton" Content="{Loc Key=Workbench.Cancel}" Click="OnCancel" />
        <Button Name="ConfirmButton" Content="{Loc Key=Workbench.Confirm}" Command="{Binding ConfirmCommand}" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
