<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:effects="using:AegiNext.Desktop.Settings.Effects"
             xmlns:controls="using:AegiNext.Desktop.Controls"
             x:Class="AegiNext.Desktop.Settings.Effects.EffectSettingsView" Classes="business-surface" x:DataType="effects:EffectSettingsViewModel">
  <Grid RowDefinitions="Auto,*" RowSpacing="12">
    <WrapPanel Name="EffectLibraryToolbar">
      <Button Name="AddEffectScriptButton" Tag="Add" Command="{Binding AddCommand}" Margin="0,0,6,6" />
      <Button Name="DuplicateEffectScriptButton" Tag="SaveEffectAs" Command="{Binding DuplicateCommand}" Margin="0,0,6,6" />
      <Button Name="DeleteEffectScriptButton" Tag="Delete" Command="{Binding DeleteCommand}" Margin="0,0,6,6" />
      <Button Name="ImportEffectScriptButton" Tag="Import" Command="{Binding ImportCommand}" Margin="0,0,6,6" />
      <Button Name="ExportEffectScriptButton" Tag="Export" Command="{Binding ExportCommand}" Margin="0,0,6,6" />
    </WrapPanel>
    <Grid Grid.Row="1" ColumnDefinitions="180,*" ColumnSpacing="12">
      <ListBox Name="EffectScriptList" ItemsSource="{Binding Effects}" SelectedItem="{Binding SelectedEffect, Mode=TwoWay}" IsEnabled="{Binding !IsBusy}">
        <ListBox.ItemTemplate>
          <DataTemplate DataType="effects:EffectScriptSettingsItem">
            <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="8">
        <TextBlock Text="{Binding EditorStatus}" FontSize="12" Opacity="0.8" TextWrapping="Wrap" />
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="8">
          <TextBlock Tag="Name" VerticalAlignment="Center" />
          <TextBox Name="EffectScriptNameInput" Grid.Column="1" Text="{Binding Name, Mode=TwoWay}" IsReadOnly="{Binding IsReadOnly}" IsEnabled="{Binding !IsBusy}" MaxLength="128" />
        </Grid>
        <controls:EffectScriptEditor Name="EffectScriptEditor" Grid.Row="2" Source="{Binding Source, Mode=TwoWay}" IsReadOnly="{Binding IsReadOnly}"
             IsEnabled="{Binding !IsBusy}" DiagnosticLine="{Binding DiagnosticLine}" DiagnosticColumn="{Binding DiagnosticColumn}" />
        <TextBlock Grid.Row="3" Text="{Binding ValidationStatus}" FontSize="12" TextWrapping="Wrap" />
        <WrapPanel Grid.Row="4">
          <Button Name="ValidateEffectScriptButton" Tag="ValidateScript" Command="{Binding ValidateCommand}" Margin="0,0,6,6" />
          <Button Name="SaveEffectScriptButton" Tag="Save" Command="{Binding SaveCommand}" Margin="0,0,6,6" />
          <Button Name="RestoreEffectScriptButton" Tag="RestoreDraft" Command="{Binding RestoreCommand}" Margin="0,0,6,6" />
        </WrapPanel>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
