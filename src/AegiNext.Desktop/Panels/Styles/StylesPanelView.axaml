<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:AegiNext.Desktop.Controls" xmlns:editing="using:AegiNext.Desktop.Editing"
             xmlns:vm="using:AegiNext.Desktop.Panels.Styles" x:DataType="vm:StylesPanelViewModel"
             x:Class="AegiNext.Desktop.Panels.Styles.StylesPanelView" Classes="business-surface">
  <ScrollViewer>
    <StackPanel Name="StylePanel" Margin="4" Spacing="8">
      <TextBlock Tag="StylePreset" Classes="field" />
      <Grid Name="StylePresetActions" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
        <ComboBox Name="SubtitleStylePresetCombo" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                  ItemsSource="{Binding Presets, Mode=OneWay}" SelectedItem="{Binding SelectedPreset, Mode=TwoWay}">
          <ComboBox.SelectionBoxItemTemplate>
            <DataTemplate x:DataType="editing:StylePresetListItem">
              <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
            </DataTemplate>
          </ComboBox.SelectionBoxItemTemplate>
        </ComboBox>
        <Button Name="ApplyStyleButton" Grid.Column="1" Tag="ApplyStyle" Command="{Binding ApplyStyleCommand}"
                IsEnabled="{Binding CanApplyPreset}" />
        <Button Name="ManageStylesButton" Grid.Column="2" Tag="ManageStyles" Command="{Binding ManageStylesCommand}" />
      </Grid>
      <TextBlock Tag="Font" Classes="field" />
      <controls:FontFamilyPicker Name="FontCombo" HorizontalAlignment="Stretch" Text="{Binding FontDraft, Mode=TwoWay}"
                                 IsEnabled="{Binding HasCue}" />
      <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
        <StackPanel Spacing="4">
          <TextBlock Tag="Size" Classes="field" />
          <controls:NumericDraftInput Name="FontSizeInput" RawText="{Binding FontSizeText, Mode=TwoWay}" Minimum="0.01"
                                      Maximum="4096" Value="{Binding FontSize, Mode=TwoWay}"
                                      IsEnabled="{Binding HasCue}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="4">
          <TextBlock Tag="StrokeWidth" Classes="field" />
          <controls:NumericDraftInput Name="StrokeWidthInput" RawText="{Binding StrokeWidthText, Mode=TwoWay}"
                                      Minimum="0" Maximum="4096" Value="{Binding StrokeWidth, Mode=TwoWay}"
                                      Increment="0.5" />
        </StackPanel>
      </Grid>
      <StackPanel Spacing="4">
        <TextBlock Tag="Fill" Classes="field" />
        <controls:ColorDraftInput Name="FillPicker" Draft="{Binding FillDraft}" />
      </StackPanel>
      <StackPanel Spacing="4">
        <TextBlock Tag="Stroke" Classes="field" />
        <controls:ColorDraftInput Name="StrokePicker" Draft="{Binding StrokeDraft}" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="16">
        <CheckBox Name="BoldCheck" Tag="Bold" IsChecked="{Binding Bold, Mode=TwoWay}" IsEnabled="{Binding HasCue}" />
        <CheckBox Name="ItalicCheck" Tag="Italic" IsChecked="{Binding Italic, Mode=TwoWay}"
                  IsEnabled="{Binding HasCue}" />
      </StackPanel>
      <TextBlock Tag="Alignment" Classes="field" />
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <ComboBox Name="AlignmentCombo" HorizontalAlignment="Stretch" SelectedIndex="{Binding Alignment, Mode=TwoWay}"
                  ItemsSource="{Binding Alignments}" IsEnabled="{Binding HasCue}" />
        <Button Name="AutomaticPositionButton" Grid.Column="1" Tag="ResetAutomaticPosition"
                Command="{Binding RestoreAutomaticPositionCommand}" IsEnabled="{Binding HasCue}" />
      </Grid>
      <StackPanel IsEnabled="{Binding HasCue}">
        <controls:SubtitlePositionEditor Name="PositionEditor" ShowAutomaticPositionAction="False"
                                         DataContext="{Binding Position}" />
      </StackPanel>
      <TextBlock Tag="KaraokeStyle" Classes="field" />
      <ComboBox Name="KaraokeStylePresetCombo" HorizontalAlignment="Stretch"
                ItemsSource="{Binding KaraokePresets, Mode=OneWay}"
                SelectedItem="{Binding SelectedKaraokePreset, Mode=TwoWay}" IsEnabled="{Binding HasCue}" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Name="KaraokeButton" Tag="Karaoke" Command="{Binding KaraokeCommand}" IsEnabled="{Binding HasCue}" />
        <Button Name="ClearKaraokeButton" Tag="ClearKaraoke" Command="{Binding ClearKaraokeCommand}"
                IsEnabled="{Binding HasCue}" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>

</UserControl>
