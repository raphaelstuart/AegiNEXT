<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><IsPackable>false</IsPackable><AllowUnsafeBlocks>true</AllowUnsafeBlocks></PropertyGroup>
  <ItemGroup Condition="'$(BaselineAssemblyRoot)' == ''">
    <None Include="../AegiNext.Rendering.Tests/Fixtures/NotoSans.ttf" Link="Fixtures/NotoSans.ttf" CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="../../src/AegiNext.Media/AegiNext.Media.csproj" />
    <ProjectReference Include="../../src/AegiNext.Rendering/AegiNext.Rendering.csproj" />
    <ProjectReference Include="../../src/AegiNext.Desktop/AegiNext.Desktop.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(BaselineAssemblyRoot)' != ''">
    <Reference Include="AegiNext.Core"><HintPath>$(BaselineAssemblyRoot)/AegiNext.Core.dll</HintPath></Reference>
    <Reference Include="AegiNext.Media"><HintPath>$(BaselineAssemblyRoot)/AegiNext.Media.dll</HintPath></Reference>
    <Reference Include="AegiNext.Rendering"><HintPath>$(BaselineAssemblyRoot)/AegiNext.Rendering.dll</HintPath></Reference>
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.HarfBuzz" />
