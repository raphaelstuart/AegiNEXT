  </ItemGroup>
  <PropertyGroup Condition="'$(BaselineAssemblyRoot)' != ''"><DefineConstants>$(DefineConstants);BASELINE_ASSEMBLIES</DefineConstants></PropertyGroup>
  <ItemGroup Condition="'$(BaselineAssemblyRoot)' != ''">
    <Compile Remove="PreviewBenchmarkGraphics.cs;PreviewBenchmarkApplication.cs;GpuPreviewVerification.cs;GpuPlaybackVerification.cs" />
  </ItemGroup>
